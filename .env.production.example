# Copy to .env.production and fill real secrets. Never commit the real file.

APP_ENV=production
APP_DEBUG=false
APP_NAME=CineTaste
API_PREFIX=/api/v1

# Your Vercel (or other) frontend origin(s), comma-separated
CORS_ORIGINS=https://cinetaste.vercel.app

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ALGORITHM=HS256

POSTGRES_USER=cinetaste
POSTGRES_PASSWORD=
POSTGRES_DB=cinetaste
# DATABASE_URL is usually injected by the host (Railway/Render) — example:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/cinetaste
REDIS_URL=

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
WATCH_PROVIDER_REGION=US
WATCH_PROVIDER_CACHE_TTL_SECONDS=43200

REC_SLATE_SIZE=20
REC_CACHE_TTL_SECONDS=600
REC_MMR_LAMBDA=0.8
REC_EXPLORATION_SLOTS=3
REC_LOG_IMPRESSIONS=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Per-account throttle for login / password reset, keyed by the email in the
# request instead of the client IP. The IP key is only as honest as the proxy
# chain in front of the API, and this one also covers attempts spread across
# many addresses. Counts failures only, so an active user is never locked out.
RATE_LIMIT_ACCOUNT_FAILURES=10
RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900

# Hosts the API will answer for. Empty = any Host header is accepted.
# Must list every legitimate route in: the API's own hostname, the SPA
# domain (it proxies /api), preview domains, and localhost for the
# container health check. Add a custom domain here BEFORE pointing DNS at
# it, or the API answers 400.
TRUSTED_HOSTS=cinetaste-api.onrender.com,cinetaste.vercel.app,*.vercel.app,localhost,127.0.0.1

WEB_CONCURRENCY=2
PORT=8000

PUBLIC_APP_URL=https://cinetaste.vercel.app
PASSWORD_RESET_TTL_MINUTES=60

# Recommended in production for real reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# Observability — create a Sentry project, paste DSNs (optional but recommended)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# Vercel frontend env (not read by API):
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_RELEASE=

# --- Added in the production-readiness pass -----------------------------------
# Cache/rate-limit store is REDIS_URL above; empty = in-process, which is
# correct for a single worker. Do not re-declare it here: dotenv keeps the
# last assignment, so a second line silently wins.
# Proxies in front of the API (Vercel rewrite -> Render = 2, Render alone = 1).
TRUSTED_PROXY_HOPS=2
# Same-site cookies: the SPA proxies /api through its own domain.
COOKIE_SAMESITE=lax
REFRESH_REUSE_GRACE_SECONDS=20
TASTE_HALF_LIFE_DAYS=365
