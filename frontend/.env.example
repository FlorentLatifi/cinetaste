# Public API base URL used by the SPA.
# Local dev: /api/v1 — vite.config proxies it to the backend.
# Production: keep /api/v1 and let vercel.json rewrite /api/* to the API. That
# keeps the refresh cookie first-party; Safari blocks third-party cookies, so
# pointing this straight at https://your-api.onrender.com/api/v1 ends sessions
# on reload for Safari/iOS users (and then COOKIE_SAMESITE=none is required).
VITE_API_BASE_URL=/api/v1

# Optional error reporting
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
