# Copy to .env for local use. Never commit real secrets.
# Production template: .env.production.example

# App — APP_ENV is one of: local | test | staging | production
APP_ENV=local
APP_DEBUG=true
APP_NAME=CineTaste
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
JWT_SECRET=local-dev-only-change-me-to-a-long-random-string-32chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ALGORITHM=HS256
# A refresh token reused within this window (two tabs) is not treated as theft.
REFRESH_REUSE_GRACE_SECONDS=20
# lax: SPA and API on the same site (Vite proxy locally, Vercel rewrite in
# production). Use none (+ https) only if the browser calls the API cross-site.
COOKIE_SAMESITE=lax

# Database
DATABASE_URL=postgresql+asyncpg://cinetaste:cinetaste@localhost:5432/cinetaste

# Cache and rate-limit store. Optional: leave empty to use an in-process store
# (fine for a single worker). docker compose sets this for you.
REDIS_URL=redis://localhost:6379/0

# Connection pool, per worker process. The deploy must satisfy
#   WEB_CONCURRENCY * (POOL_SIZE + MAX_OVERFLOW) < the host's max_connections
# (Render free Postgres allows ~97). Timeout is short on purpose: a request
# that waits 30s for a connection has already lost the user.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800

# Catalog (TMDb)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Where-to-watch (TMDb / JustWatch). ISO-3166-1 alpha-2 default.
WATCH_PROVIDER_REGION=US
WATCH_PROVIDER_CACHE_TTL_SECONDS=43200

# Recommendations
REC_SLATE_SIZE=20
REC_CACHE_TTL_SECONDS=600
REC_MMR_LAMBDA=0.8
REC_EXPLORATION_SLOTS=3
REC_LOG_IMPRESSIONS=true
# Interactions lose half their influence after this many days (0 = no decay).
TASTE_HALF_LIFE_DAYS=365

# Rebuild the taste profile after the response rather than inside the request
# that recorded the rating. The rebuild re-reads the whole history — measured
# 93 ms at 100 ratings and 558 ms at 2,000 — while what the user sees straight
# away (the title leaving the feed, undo, history) comes from the event log.
# Set false to rebuild inline: slower, but a restart cannot lose a rebuild.
TASTE_RECOMPUTE_DEFERRED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Per-account throttle for login / password reset, keyed by the email in the
# request instead of the client IP. The IP key is only as honest as the proxy
# chain in front of the API, and this one also covers attempts spread across
# many addresses. Counts failures only, so an active user is never locked out.
RATE_LIMIT_ACCOUNT_FAILURES=10
RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900

TRUSTED_HOSTS=
# Reverse proxies in front of the API that append to X-Forwarded-For.
# 0 locally; 1 behind Render alone; 2 behind a Vercel rewrite -> Render.
TRUSTED_PROXY_HOPS=0

# Public SPA URL used in password-reset links (must be https outside local)
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60

# Email verification. Off by default — turning it on without working SMTP would
# lock every account out, so production refuses that combination outright.
# When on, the product endpoints need a confirmed address; /me, taste export,
# resending the link and deleting the account stay reachable so the user can
# get out of the state.
EMAIL_VERIFICATION_TTL_HOURS=48
REQUIRE_EMAIL_VERIFICATION=false

# SMTP. Empty outside local/test means password reset returns 503 instead of
# silently doing nothing; locally the reset token comes back in the response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Observability (optional — leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# Frontend build-time (Vercel): VITE_SENTRY_DSN=
